# 首次启动必须设置。此文件复制为 .env 后修改。
ADMIN_PASSWORD=
DB_PASSWORD=
# 本机 HTTP 演示为 false；生产 HTTPS 必须 true。
COOKIE_SECURE=false
MODEL_ENABLED=false
MODEL_BASE_URL=http://host.docker.internal:11434/v1
MODEL_API_KEY=ollama
CHAT_MODEL=qwen2.5:7b
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_VERSION=v1

# Optional OCR / scanner / S3 settings
OCR_ENABLED=false
OCR_ALL_PAGES=false
OCR_MIN_TEXT_CHARS=20
OCR_TIMEOUT_SECONDS=60
OCR_LANGUAGES=chi_sim+eng
CLAMD_TIMEOUT_MS=15000
S3_PATH_STYLE=true
# compose.integrations.yaml additionally requires distinct MinIO administrator
# and application credentials. Set these in your private .env, never commit keys.
# MINIO_ROOT_USER=rag-admin
# MINIO_ROOT_PASSWORD=<set-a-strong-password>
# S3_ACCESS_KEY=rag-app
# S3_SECRET_KEY=<set-a-different-strong-password>
